# Copy to .env or export before running the app
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Application admin / fallback for production bootstrap
APP_ADMIN_USERNAME=prodadmin
APP_ADMIN_PASSWORD=ChangeMeStrongPassword123!
APP_ADMIN_ROLES=ROLE_ADMIN,ROLE_USER

# JWT configuration
JWT_SECRET=change-me-production-secret-key-32-bytes
JWT_EXPIRATION_MS=3600000

# MySQL production database
DB_URL=jdbc:mysql://localhost:3306/businesscase?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=businesscase_user
DB_PASSWORD=StrongDatabasePassword123!
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
DDL_AUTO=update
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
